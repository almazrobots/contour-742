{
  "_meta": { "description": "Data stream inspector-logs* → ILM inspector-logs (ТЗ 12.5, 13.3: логи INFO и выше хранятся 90 дней (TZA-12.5-01, TZA-13.3-01))" },
  "index_patterns": ["inspector-logs*"],
  "data_stream": {},
  "priority": 500,
  "template": {
    "settings": {
      "index.lifecycle.name": "inspector-logs",
      "index.number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "level": { "type": "keyword" },
        "service": { "type": "keyword" },
        "message": { "type": "text", "fields": { "raw": { "type": "keyword", "ignore_above": 1024 } } },
        "request_id": { "type": "keyword" },
        "user_id": { "type": "keyword" }
      }
    }
  }
}
