# Профиль gpu. Копия → .env (вне git). Образы — ТОЛЬКО по digest: имя@sha256:<64 hex>.
# Сторонние образы закреплены 2026-09-25 по API реестров (Docker Hub); обновление — недельной пересборкой (T-060).
API_IMAGE=  # из гейта CI: <реестр>/inspector-api@sha256:… (ADR-0005, сборки на хосте нет)
ML_GPU_IMAGE=  # из гейта: <реестр>/inspector-ml-gpu@sha256:… — цель gpu ml/Dockerfile (--target gpu: GPU-OCR, веса PP-OCR в образе, T-230)
# vLLM с PaddleOCR-VL-1.5 и Qwen3.5-9B (OpenAI API; ревизии — ml/models.yaml, запуск — deploy/gpu-stand/vllm.sh). Открытый http — только петля (SEC-09)
VLM_URL=
WEB_IMAGE=  # из гейта CI: <реестр>/inspector-web@sha256:…
POSTGRES_IMAGE=postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873  # 18.6, закреплён 2026-09-26 (T-107)
RABBITMQ_IMAGE=rabbitmq:4.3-management-alpine@sha256:ce634665a8e7262384a793581c20cb8a46343887446eb391b77c814febeca4b2
REDIS_IMAGE=redis:8.8-alpine@sha256:0b2b77d3ea5078274795e3177cdbdada8b96316684a38911d528534ed679b5ec
CLAMAV_IMAGE=clamav/clamav:stable@sha256:0e31ce089574268aefa0b543767d66b70240ab51ed49eec53e07f18d5629d817
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.1@sha256:e9733bafb1bdef9b00e25a21f8f99dc26a22224bf16641ad754d1649f4c3357a
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.28.0@sha256:e753ff9f3fc458d02cca5eddab5a77e1c175eee484a8925ac7d524f04366c2fc  # NFR-SLA, закреплён 2026-09-27 (T-137)
GRAFANA_IMAGE=grafana/grafana:12.4.11@sha256:3ea272e5cab64a4a62240c682e2c62433b25614d956d44c299a10cb6994f6f2e
ELASTICSEARCH_IMAGE=elasticsearch:9.5.3@sha256:a4e2b3d21ad0f779f3044bb6828b5289d5f1c241b3ddd7efae7adaf81bcff412
LOGSTASH_IMAGE=logstash:9.5.3@sha256:82bbb493bb07423b6f24adeb0edfb9cafa55e2be1a6ae1e5afee2e796f852343
KIBANA_IMAGE=kibana:9.5.3@sha256:6b7a4807cc9546c2c538d85e080a159b33984a7ef9556c0ca11f3c7397ab1bbf
# ТЗ 13.7 (T-085): конфиг Alertmanager стенда (по образцу deploy/gpu/alertmanager/alertmanager.example.yml) и каталог секретов
# с файлами tg_bot_token, tg_chat_id, smtp_password — вне git, читаемы uid nobody (65534)
ALERTMANAGER_CONFIG=
ALERTMANAGER_SECRETS=
# ADR-0003 (T-107), аудит БД 2026-09-26 (HIGH-1, L-7): у каждой роли PostgreSQL — свой файл-секрет вне git, одна
# строка без пробелов по краям. Compose без swarm не меняет владельца: один читающий uid — владелец и 0400, два — 0440.
# Пароли ролей приложения init-скрипт (postgres/init/10-roles.sh) читает ОДИН раз — при инициализации пустого тома
# postgres-data; смена пароля позже — ALTER ROLE вручную суперпользователем и новый файл.
# Суперпользователь postgres: только сервис postgres (uid 70), по сети не входит; API и службе миграций не выдаётся
PG_SUPERUSER_PASSWORD_FILE=
# inspector_migrator (миграции, сиды): postgres при init и api-migrate (uid 1000). Файл читают оба uid — 0440, группа общая
PG_MIGRATOR_PASSWORD_FILE=
# inspector_app (рантайм API, только DML): postgres при init и api (uid 1000). Файл читают оба uid — 0440, группа общая
PG_APP_PASSWORD_FILE=
# M-1: TLS сервера PostgreSQL — каталог с server.crt (SAN DNS:postgres, выпущен CA из TLS_DIR/ca.crt — им API и
# api-migrate проверяют сервер, verify-full) и server.key (владелец uid 70, режим 0600 — иначе postgres не стартует)
PG_TLS_DIR=
# NFR-BACKUP (T-072, ТЗ 12.8): каталоги хоста для базовых бэкапов (служба pg-backup, 30 дней) и архива WAL (archive_command).
# Отдельный от тома postgres-data диск; владелец uid 70 (postgres в alpine), режим 0700: mkdir -p … && chown 70:70 … && chmod 700 …
PG_BACKUP_DIR=
PG_WAL_ARCHIVE_DIR=
# HIGH-4: первый администратор (демо-учёток в gpu нет). api-migrate создаёт его, только если users пуст; пароль ≥ 12
# символов, не содержит логин. Файл — владелец uid 1000, 0400; после первого входа можно заменить заглушкой
BOOTSTRAP_ADMIN_PASSWORD_FILE=
BOOTSTRAP_ADMIN_LOGIN=admin
# NFR-CRYPTO (ТЗ 12.3-01): ключ хранения файлов пакета на томе api-blobs — 64 hex (openssl rand -hex 32), вне git,
# владелец uid 1000, 0400. Потеря = потеря файлов на томе: копия — вместе с резервной копией секретов. Ротация и
# старые ключи — docs/security/AT-REST.md. Тома (postgres-data, api-blobs, бэкапы) — только на LUKS: deploy/gpu/up.sh
# проверяет это at-rest-check.sh; каталоги бэкапов и архива WAL на хосте — в AT_REST_EXTRA_PATHS (через пробел)
BLOB_ENCRYPTION_KEY_FILE=
AT_REST_EXTRA_PATHS=
# NFR-UKEP: подпись запросов к ИАИС «РиН». Сертифицированного СКЗИ нет (решение владельца 27.09) — коннектор pem с тестовой
# парой: scripts/ukep-test-key.sh <каталог> (ECDSA P-256, самоподписанный, пометка «не УКЭП»); /health покажет qualified:false.
# Настоящий ключ: UKEP_MODE=cryptopro, UKEP_NONQUALIFIED=0 и INSPECTOR_UKEP_THUMBPRINT в окружении api.
UKEP_MODE=pem
UKEP_NONQUALIFIED=1
UKEP_CERT_FILE=
UKEP_KEY_FILE=
# SEC-07: пароль брокера — файлами, не переменной: RABBITMQ_PASSWORD_FILE — сам пароль (API читает секретом),
# RABBITMQ_AUTH_CONF — conf.d брокера из двух строк «default_user = inspector» и «default_pass = <тот же пароль>»
RABBITMQ_PASSWORD_FILE=
RABBITMQ_AUTH_CONF=
GRAFANA_PASSWORD=
# NFR-TLS (ТЗ 12.3), NFR-TLS-INTERNAL (ТЗ 1.3): каталог на хосте, монтируется read-only. server.crt (цепочка; SAN включает
# DNS:api, DNS:ml, DNS:rabbitmq, DNS:redis, DNS:elasticsearch — имена, по которым сервисы ходят друг к другу по TLS, — и
# внешнее имя стенда для web), server.key (читают uid контейнеров: API 1000, web 101, ML 10001, RabbitMQ, Redis, ES 1000), ca.crt.
TLS_DIR=
# ELK (ТЗ 13.6): суперпользователь elastic — только для настройки; Kibana и Logstash ходят своими учётками
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
LOGSTASH_WRITER_PASSWORD=
RIN_URL=https://rin.example  # адрес ИАИС «РиН», контракт — T-067

# ── Блобы в S3 (надстройка compose.s3.yml, ADR-0006). Без неё блобы — на томе api-blobs.
# Ключи — файлами; у API свой сервисный аккаунт с ролью только на свой префикс (ADR-0004 п. 6).
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_PREFIX=blobs/
S3_ACCESS_KEY_ID_FILE=
S3_SECRET_ACCESS_KEY_FILE=
S3_ENCRYPTION_KEY_FILE=

# ── Копии бэкапов вне хоста (надстройка compose.backup-s3.yml, NFR-BACKUP T-072). Бакет — с правилом жизненного цикла
# 30 дней и object lock; у службы свой сервисный аккаунт с правом записи только в префикс backups/. Ключи — файлами (uid 70, 0400).
RCLONE_IMAGE=rclone/rclone:1.75.1@sha256:45401ad7410db1d67ffdb58e19059ad20b0d8e0285a60e38bbec55cc1019c7a5  # закреплён 2026-09-27 (Docker Hub)
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID_FILE=
BACKUP_S3_SECRET_ACCESS_KEY_FILE=
