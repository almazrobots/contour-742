{
  "name": "@inspector/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && INSPECTOR_PERF=1 vitest run --reporter=verbose",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/multipart": "^10.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqplib": "^2.0.1",
    "asn1js": "^3.0.10",
    "fastify": "^5.12.5",
    "pg": "8.23.0",
    "pkijs": "^3.4.1",
    "undici": "7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.19.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
